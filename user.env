# WARNING: this file is tracked in git. Do not enter real credentials/tokens here - anyone with
# repo access (and, if this repo is ever published, anyone on the internet) can read them, and
# they will be committed to history permanently even if later changed. Use a local,
# git-ignored override instead (e.g. docker-compose.override.yaml, see "Hardening the Stack" in
# the root Readme) or a proper secret store for real deployments. The values below are
# placeholders for local testing only.
GRAFANA_URL=http://grafana:3000
#GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx_xxxxxxxx
GRAFANA_USERNAME=
GRAFANA_PASSWORD=
# Host-header allowlist for mcp-grafana's own HTTP endpoint (DNS-rebinding guard).
# "*" disables it. Narrow to e.g. localhost:38000,127.0.0.1:38000 if port 38000 is
# ever reachable from untrusted networks.
MCP_ALLOWED_HOSTS=*