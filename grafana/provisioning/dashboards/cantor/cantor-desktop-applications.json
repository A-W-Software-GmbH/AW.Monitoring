          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Process Instances Seen (range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aw_prometheus" },
      "description": "Process Instances Seen (range) minus Running Instances — the number of PIDs observed during the selected time range that are no longer running now. This counts ANY process termination, not just crashes/restarts: closing a running Ca*.exe normally also increases this by one, since 'seen' still includes its PID while 'running' no longer does. It cannot distinguish a crash/restart from a deliberate shutdown by itself - cross-check with the Logs panel below (or a process-start/restart event metric, if one becomes available) before treating a non-zero value as instability. Conversely, Windows reusing the same PID across two separate launches of the same service/host combination can under-count distinct starts.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 18,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "13.0.1",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "aw_prometheus" },
          "expr": "count(count by (service_name, host_name, process_pid) (max_over_time(aw_process_up_ratio{service_name=~\"(?i)^ca.*\\\\.exe$\", deployment_environment_name=~\"${deployment:regex}\"}[$__range]))) - count(aw_process_up_ratio{service_name=~\"(?i)^ca.*\\\\.exe$\", deployment_environment_name=~\"${deployment:regex}\"} == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Terminated Instances (range)",
      "type": "stat"
