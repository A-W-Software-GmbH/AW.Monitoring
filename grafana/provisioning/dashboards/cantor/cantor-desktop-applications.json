    {
      "datasource": { "type": "prometheus", "uid": "aw_prometheus" },
      "description": "Distinct (service, host, PID) combinations observed at any point in the selected time range. If this exceeds 'Running Instances', a process exited/restarted (new PID) during the window — a proxy for crash/restart churn.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
