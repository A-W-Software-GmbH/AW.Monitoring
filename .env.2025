NANOSERVER_IMAGE_PATH="mcr.microsoft.com/windows/nanoserver"
NANOSERVER_IMAGE_VERSION="ltsc2025"
DOWNLOADER_IMAGE_PATH="mcr.microsoft.com/dotnet/sdk"
DOWNLOADER_IMAGE_VERSION="8.0-nanoserver-ltsc2025"
SERVERCORE_IMAGE_PATH="mcr.microsoft.com/windows/servercore"
SERVERCORE_IMAGE_VERSION="ltsc2025"
MONITORING_VERSION="1.0.6"

# Uncomment to serve Grafana over HTTPS. Drop your cert/key into ./grafana/certs
# (filenames below) or point GRAFANA_CERTS_DIR at a different host folder.
#GRAFANA_PROTOCOL=https
#GRAFANA_CERT_FILENAME=server.crt
#GRAFANA_CERT_KEYNAME=server.key
#GRAFANA_CERTS_DIR=./grafana/certs
# Must match a hostname covered by the cert's SAN and match what you actually type into the
# browser - Grafana uses this to build root_url; a mismatch here is what makes an otherwise
# valid HTTPS cert still show as "Not secure" (Grafana links itself with the wrong host/scheme).
#GRAFANA_DOMAIN=localhost